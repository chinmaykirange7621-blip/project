# ScholarAI Environment Configuration
# Copy this file to .env (in project root or backend/.env) and configure values.

# Google Gemini API (leave empty to run in transparent Demo Mode)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database (SQLite by default; swap with PostgreSQL connection string if desired)
# Relative paths are resolved from the project root directory
DATABASE_URL=sqlite:///data/scholarai.db

# ChromaDB persistent directory
CHROMA_PERSIST_DIR=data/chroma_db

# JWT Admin Authentication
JWT_SECRET_KEY=scholarai-dev-secret-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ScholarAdmin@2026

# CORS Allowed Origins (comma-separated) and optional regex for Render preview/static URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
